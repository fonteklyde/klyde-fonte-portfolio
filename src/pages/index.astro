---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CertificationCard from "../components/CertificationCard.astro";
import ContactForm from "../components/ContactForm.astro";
import PersonSchema from "../components/SEO/PersonSchema.astro";

const projects = await getCollection("projects");
projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const certifications = await getCollection("certifications");
certifications.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Klyde Dexter Fonte — Software Engineer | Data Scientist | Data Analyst">
  <PersonSchema slot="json-ld" />
  <div data-animate class="opacity-0">
    <Hero />
  </div>

  <section
    id="projects"
    class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 border-t border-slate-200/60"
  >
    <div data-animate class="opacity-0 text-center max-w-2xl mx-auto">
      <span
        class="text-xs font-bold uppercase tracking-widest text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100"
      >
        Portfolio & Work
      </span>
      <h2
        class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight"
      >
        Featured Projects
      </h2>
      <p class="mt-3 text-base sm:text-lg text-slate-600">
        A selection of real-world applications showcasing scalable web
        architectures, full-stack development, and clean user interfaces.
      </p>
    </div>

    <!-- Projects Grid -->
    <div
      id="projects-grid"
      class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        projects.map((project) => (
          <div data-animate class="opacity-0 flex flex-col">
            <ProjectCard project={project} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Certifications Highlight Section -->
  <section class="bg-white py-16 md:py-24 border-t border-slate-200/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-animate class="opacity-0 flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100">
            Credentials
          </span>
          <h2 class="mt-3 text-3xl font-extrabold text-slate-900 tracking-tight">
            Certifications & Technical Training
          </h2>
        </div>
        <a
          href="/about"
          class="inline-flex items-center gap-1 text-sm font-bold text-indigo-600 hover:text-indigo-700 transition-colors"
        >
          View Full Background & Education →
        </a>
      </div>

      <div data-animate class="opacity-0 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {certifications.map((cert) => (
          <CertificationCard certification={cert} />
        ))}
      </div>
    </div>
  </section>

  <div data-animate class="opacity-0 border-t border-slate-200/60">
    <ContactForm />
  </div>
</Layout>
