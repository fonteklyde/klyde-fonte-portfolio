---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactForm from '../components/ContactForm.astro';

const projects = await getCollection('projects');
projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout>
  <Hero />

  <section id="projects" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <h2 class="text-3xl font-bold text-gray-900 text-center">Projects</h2>
    <p class="mt-2 text-center text-gray-600 max-w-lg mx-auto">
      A few projects that showcase my approach to solving real problems.
    </p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, i) => (
        <div class={`animate-fade-in delay-${Math.min(i + 1, 3)}`}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  </section>

  <ContactForm />
</Layout>
