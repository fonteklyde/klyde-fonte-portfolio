---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import EducationCard from "../components/EducationCard.astro";
import CertificationCard from "../components/CertificationCard.astro";
import PersonSchema from "../components/SEO/PersonSchema.astro";
import BreadcrumbSchema from "../components/SEO/BreadcrumbSchema.astro";

const educationList = await getCollection("education");
educationList.sort((a, b) => a.data.order - b.data.order);

const certificationsList = await getCollection("certifications");
certificationsList.sort((a, b) => a.data.order - b.data.order);

const skills = [
  "Data analysis",
  "Data cleaning",
  "Data visualization",
  "Python programming",
  "Data-driven decision making",
  "Effective presentations",
  "Calculation and analysis in SQL and spreadsheets",
];

const milestones = [
  {
    period: "2026",
    role: "Software Engineer Intern — Infosoft Consulting Corporation",
    description:
      "Architected and deployed the Infosoft DTR System utilizing Laravel, Inertia.js, React, Mapbox GL JS geofencing, and TensorFlow.js facial recognition for automated biometric timekeeping.",
  },
  {
    period: "2025-2026",
    role: "Data Analyst — Peroptyx",
    description:
      "Evaluated and rated search query results using proprietary guidelines, directly improving map routing accuracy and local search relevance for end-users.",
  },
];
---

<Layout
  title="About Klyde Dexter Fonte — Data Analyst | Data Scientist"
  description="Learn more about Klyde Dexter Fonte's background, education, technical skills, certifications, and experience as a Data Analyst and Data Scientist in the Philippines."
>
  <Fragment slot="json-ld">
    <PersonSchema />
    <BreadcrumbSchema pageName="About Me" pageUrl="/about" />
  </Fragment>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <!-- Header -->
    <div data-animate class="opacity-0 max-w-2xl">
      <span
        class="text-xs font-bold uppercase tracking-widest text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100"
      >
        About Me
      </span>
      <h1
        class="mt-4 text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight"
      >
        Driven by Curiosity. Focused on Data-Driven Insights.
      </h1>
    </div>

    <!-- Personal Story -->
    <div
      data-animate
      class="mt-8 opacity-0 grid gap-8 md:grid-cols-3 items-start"
    >
      <div
        class="md:col-span-2 space-y-5 text-slate-600 text-base sm:text-lg leading-relaxed"
      >
        <p class="font-medium text-slate-900">
          I am a versatile individual experienced in collecting, transforming,
          and organizing data for analysis to help organizations make informed
          decisions.
        </p>
        <p>
          Having recently completed the Google Data Analytics Certificate—a
          rigorous, hands-on program that covers the entire scope of the data
          analysis process—I bring a structured, end-to-end approach to asking
          the right business questions, preparing and processing data,
          performing deep analysis, and sharing meaningful outcomes.
        </p>
        <p>
          Equipped with an excellent understanding and proficiency of platforms
          for effective data analyses—including SQL, spreadsheets (Excel &
          Google Sheets), Tableau, and Python—I specialize in data cleaning,
          calculation and analysis in SQL and spreadsheets, and building clear,
          interactive data visualizations.
        </p>
        <p>
          Leveraging strong communication, organizational, and analytical
          skills, I bridge the gap between raw figures and strategic goals,
          delivering effective presentations that foster confident, data-driven
          decision making across teams.
        </p>
      </div>

      <!-- Quick Facts Sidebar -->
      <div
        class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4"
      >
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">
          Quick Snapshot
        </h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-center gap-2 text-slate-700">
            <span class="text-indigo-600 font-bold">📍</span> Location: Philippines
          </li>
          <li class="flex items-center gap-2 text-slate-700">
            <span class="text-indigo-600 font-bold">📊</span> Focus: Data Analytics
          </li>
          <li class="flex items-center gap-2 text-slate-700">
            <span class="text-indigo-600 font-bold">🎮</span> Hobbies: Gaming, Movies,
            Gym
          </li>
        </ul>

        <div class="pt-2 border-t border-slate-100">
          <a
            href="/#contact"
            class="block w-full text-center px-4 py-2.5 bg-slate-900 text-white font-semibold text-xs rounded-xl hover:bg-indigo-600 transition-colors"
          >
            Get in Touch
          </a>
        </div>
      </div>
    </div>

    <!-- Skills Section -->
    <div data-animate class="mt-16 opacity-0">
      <h2
        class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2"
      >
        <span class="w-3 h-3 rounded-full bg-indigo-600"></span>
        Skills
      </h2>

      <ul class="grid gap-3 sm:grid-cols-2 pl-1">
        {
          skills.map((skill) => (
            <li class="flex items-start gap-3 text-slate-700 font-medium text-base sm:text-lg">
              <span class="text-indigo-600 font-bold text-xl leading-none select-none mt-0.5">
                •
              </span>
              <span>{skill}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Experience & Milestones Timeline -->
    <div data-animate class="mt-16 opacity-0">
      <h2
        class="text-2xl font-bold text-slate-900 mb-8 flex items-center gap-2"
      >
        <span class="w-3 h-3 rounded-full bg-indigo-600"></span>
        Professional Experience
      </h2>

      <div class="relative pl-6 border-l-2 border-slate-200 space-y-8">
        {
          milestones.map((m) => (
            <div class="relative group">
              <div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-white border-2 border-indigo-600 group-hover:bg-indigo-600 transition-colors" />
              <span class="text-xs font-bold text-indigo-600 uppercase tracking-wide">
                {m.period}
              </span>
              <h3 class="text-lg font-bold text-slate-900 mt-1">{m.role}</h3>
              <p class="mt-2 text-slate-600 text-sm sm:text-base leading-relaxed">
                {m.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Education Section -->
    <div data-animate class="mt-16 opacity-0">
      <h2
        class="text-2xl font-bold text-slate-900 mb-8 flex items-center gap-2"
      >
        <span class="w-3 h-3 rounded-full bg-indigo-600"></span>
        Education
      </h2>

      <div class="mt-6">
        {educationList.map((edu) => <EducationCard education={edu} />)}
      </div>
    </div>

    <!-- Certifications Section -->
    <div data-animate class="mt-16 opacity-0">
      <h2
        class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2"
      >
        <span class="w-3 h-3 rounded-full bg-indigo-600"></span>
        Certifications & Seminars
      </h2>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          certificationsList.map((cert) => (
            <CertificationCard certification={cert} />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
