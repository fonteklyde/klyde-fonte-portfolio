---
const siteUrl = Astro.site ? Astro.site.origin : "https://klyde-fonte-portfolio.vercel.app";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  "name": "Klyde Dexter Fonte",
  "givenName": "Klyde Dexter",
  "familyName": "Fonte",
  "jobTitle": "Data Analyst | Data Scientist",
  "url": siteUrl,
  "sameAs": [
    "https://github.com/fonteklyde",
    "https://www.linkedin.com/in/klyde-dexter-fonte-2630292b7/"
  ],
  "knowsAbout": [
    "Data Analytics",
    "Data Science",
    "SQL",
    "R",
    "Python",
    "Microsoft Excel",
    "Google Sheets",
    "Pivot Table",
    "Tableau",
    "Looker",
    "Exploratory Data Analysis (EDA)",
    "Data Mining",
    "Predictive Modeling"
  ],
  "description": "Data Analyst and Data Scientist in the Philippines specializing in SQL, R, Python, Tableau, Looker, Excel, and predictive data modeling."
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Klyde Dexter Fonte Portfolio",
  "description": "Portfolio of Klyde Dexter Fonte - Data Analyst | Data Scientist",
  "publisher": {
    "@id": `${siteUrl}/#person`
  }
};
---

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
