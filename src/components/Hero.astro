---
export interface Props {
  headline?: string;
  subtitle?: string;
}

const {
  headline = "Data Analyst",
  subtitle = "Passionate about transforming complex datasets into actionable business insights and strategic solutions. Proficient in SQL, R, Python, spreadsheets, and data visualization tools like Tableau and Looker. Experienced in exploratory data analysis (EDA), predictive modeling, and statistical data pipelines.",
} = Astro.props;
---

<section
  class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 overflow-hidden"
>
  <!-- Decorative background radial glow -->
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none -z-10"
  >
  </div>

  <div class="flex flex-col md:flex-row items-center gap-10 lg:gap-16">
    <div class="flex-shrink-0 relative group">
      <div
        class="absolute -inset-1 bg-gradient-to-r from-indigo-500 to-slate-900 rounded-full blur opacity-25 group-hover:opacity-50 transition duration-500"
      >
      </div>
      <img
        src="/images/1.webp"
        alt="Klyde Dexter Fonte professional headshot"
        width="280"
        height="280"
        class="relative rounded-full object-cover w-48 h-48 sm:w-60 sm:h-60 md:w-72 md:h-72 ring-4 ring-white shadow-xl"
        loading="eager"
      />
    </div>

    <div class="text-center md:text-left flex-1">
      <!-- Status Badge -->
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 border border-indigo-200 text-indigo-700 text-xs font-semibold tracking-wide uppercase mb-6"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"
          ></span>
        </span>
        Available for New Opportunities
      </div>

      <h1
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-[1.15] tracking-tight"
      >
        {headline}
      </h1>

      <p
        class="mt-4 text-base sm:text-lg md:text-xl text-slate-600 max-w-2xl font-normal leading-relaxed"
      >
        {subtitle}
      </p>

      <!-- Action Buttons -->
      <div
        class="mt-8 flex flex-wrap items-center justify-center md:justify-start gap-4"
      >
        <a
          href="/#projects"
          class="inline-flex items-center justify-center px-7 py-3 min-h-[44px] bg-slate-900 text-white font-semibold text-sm rounded-xl hover:bg-indigo-600 transition-all shadow-md hover:shadow-indigo-500/20 group"
        >
          View My Work
          <svg
            class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>

        <a
          href="/resume"
          class="inline-flex items-center justify-center px-6 py-3 min-h-[44px] bg-slate-100 border border-slate-200 text-slate-800 font-semibold text-sm rounded-xl hover:bg-slate-200 hover:border-slate-300 transition-all gap-1.5"
        >
          <svg
            class="w-4 h-4 text-indigo-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          Resume / CV
        </a>

        <a
          href="/#contact"
          class="inline-flex items-center justify-center px-6 py-3 min-h-[44px] bg-white border border-slate-300 text-slate-800 font-semibold text-sm rounded-xl hover:bg-slate-50 hover:border-slate-400 transition-all"
        >
          Get in Touch
        </a>

        <a
          href="https://github.com/fonteklyde"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 text-slate-500 hover:text-slate-900 transition-colors"
          aria-label="GitHub Profile"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/klyde-dexter-fonte-2630292b7/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 text-slate-500 hover:text-slate-900 transition-colors"
          aria-label="LinkedIn Profile"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
