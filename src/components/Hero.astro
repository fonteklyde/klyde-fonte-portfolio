---
export interface Props {
  headline?: string;
  subtitle?: string;
}

const {
  headline = "I Turn Complex Problems into Elegant Code.",
  subtitle = "Full-Stack Developer specializing in scalable architectures, clean APIs, and user-centric design. Let’s build something that works as beautifully as it looks.",
} = Astro.props;
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32">
  <div class="flex flex-col md:flex-row items-center gap-12">
    <div class="flex-shrink-0">
      <img
        src="/images/1.jpg"
        alt="Professional headshot"
        width="280"
        height="280"
        class="rounded-full object-cover w-56 h-56 md:w-72 md:h-72 shadow-lg"
      />
    </div>
    <div class="text-center md:text-left">
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight"
      >
        {headline}
      </h1>
      <p class="mt-4 text-lg md:text-xl text-gray-600 max-w-xl">
        {subtitle}
      </p>
      <a
        href="/#projects"
        class="inline-block mt-8 px-8 py-3 min-h-[44px] bg-gray-900 text-white font-semibold rounded-lg hover:bg-gray-800 transition-colors"
      >
        View My Work
      </a>
    </div>
  </div>
</section>
