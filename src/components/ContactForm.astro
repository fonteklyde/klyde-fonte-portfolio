---
const FORMSPREE_ID = import.meta.env.PUBLIC_FORMSPREE_ID || "xrgvkyze"; // Fallback ID if not set
---

<section
  id="contact"
  class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24"
>
  <div class="text-center max-w-xl mx-auto">
    <span
      class="text-xs font-bold uppercase tracking-widest text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-100"
    >
      Contact
    </span>
    <h2
      class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight"
    >
      Let's Build Something Together
    </h2>
    <p class="mt-3 text-slate-600 text-base sm:text-lg">
      Have a question, project proposal, or just want to connect? Send me a
      message and I'll respond as soon as possible.
    </p>
  </div>

  <form
    id="contact-form"
    action={`https://formspree.io/f/${FORMSPREE_ID}`}
    method="POST"
    class="mt-10 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-6"
  >
    <!-- Status Notification Alert -->
    <div id="form-alert" class="hidden p-4 rounded-xl text-sm font-medium">
    </div>

    <div>
      <label
        for="name"
        class="block text-sm font-semibold text-slate-700 mb-1.5"
      >
        Your Name <span class="text-rose-500">*</span>
      </label>
      <input
        id="name"
        name="name"
        type="text"
        required
        placeholder="e.g. Juan Dela Cruz"
        class="w-full px-4 py-3 min-h-[44px] bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:bg-white transition-all text-sm font-medium"
      />
    </div>

    <div>
      <label
        for="email"
        class="block text-sm font-semibold text-slate-700 mb-1.5"
      >
        Email Address <span class="text-rose-500">*</span>
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        placeholder="juandelacruz@example.com"
        class="w-full px-4 py-3 min-h-[44px] bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:bg-white transition-all text-sm font-medium"
      />
    </div>

    <div>
      <label
        for="message"
        class="block text-sm font-semibold text-slate-700 mb-1.5"
      >
        Message <span class="text-rose-500">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        placeholder="Tell me about your project, goals, or timeline..."
        class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:bg-white transition-all text-sm font-medium resize-y"
      ></textarea>
    </div>

    <button
      id="submit-btn"
      type="submit"
      class="w-full px-8 py-3.5 min-h-[48px] bg-slate-900 text-white font-semibold rounded-xl hover:bg-indigo-600 transition-all text-sm shadow-md flex items-center justify-center gap-2 group"
    >
      <span id="btn-text">Send Message</span>
      <svg
        id="btn-spinner"
        class="hidden animate-spin w-4 h-4 text-white"
        fill="none"
        viewBox="0 0 24 24"
      >
        <circle
          class="opacity-25"
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          stroke-width="4"></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path>
      </svg>
      <svg
        id="btn-arrow"
        class="w-4 h-4 group-hover:translate-x-1 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </button>
  </form>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    const alertBox = document.getElementById("form-alert");
    const submitBtn = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement | null;
    const btnText = document.getElementById("btn-text");
    const btnSpinner = document.getElementById("btn-spinner");
    const btnArrow = document.getElementById("btn-arrow");

    if (form && alertBox && submitBtn && btnText && btnSpinner && btnArrow) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        // Show loading state
        submitBtn.disabled = true;
        btnText.textContent = "Sending...";
        btnSpinner.classList.remove("hidden");
        btnArrow.classList.add("hidden");
        alertBox.classList.add("hidden");

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: "POST",
            body: formData,
            headers: {
              Accept: "application/json",
            },
          });

          if (response.ok) {
            form.reset();
            alertBox.className =
              "p-4 rounded-xl text-sm font-medium bg-emerald-50 border border-emerald-200 text-emerald-800";
            alertBox.textContent =
              "Thank you! Your message has been sent successfully. I'll get back to you shortly.";
          } else {
            throw new Error("Form submission failed.");
          }
        } catch (error) {
          alertBox.className =
            "p-4 rounded-xl text-sm font-medium bg-rose-50 border border-rose-200 text-rose-800";
          alertBox.textContent =
            "Oops! There was a problem sending your message. Please try again or reach out via LinkedIn.";
        } finally {
          alertBox.classList.remove("hidden");
          submitBtn.disabled = false;
          btnText.textContent = "Send Message";
          btnSpinner.classList.add("hidden");
          btnArrow.classList.remove("hidden");
        }
      });
    }
  });
</script>
